<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  앱에서 알림을 받으려면 이 한 줄이 있어야 한다. 없으면 폰이
	  `no valid aps-environment entitlement string found`로 등록을 거절하고,
	  **알림만 조용히 안 온다.**

	  `production`이다 — 우리는 TestFlight와 앱스토어로만 내보내고
	  (`.github/workflows/ios.yml`), 그 둘이 다 이쪽이다. 맥에 꽂아 돌리는
	  개발용 빌드를 할 일이 생기면 그때만 `development`가 필요하다.
	-->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
