<?xml version="1.0" encoding="utf-8"?>
<!--
  알림 채널에 쓰는 값들. **`MainActivity`(채널을 만드는 곳)와
  `AndroidManifest.xml`(기본값을 적어 두는 곳)이 같이 읽는다** —
  글자를 양쪽에 적어 두면 한쪽만 고치는 날 소리가 조용히 기본음으로
  돌아가므로 한 군데에 모았다.
-->
<resources>
    <!--
      **채널 id는 소리와 한 몸이다.** 안드로이드 8부터 알림음은 payload가
      아니라 **채널에 박히고**, 한 번 만들어진 채널의 소리는 앱을 고쳐도
      안 바뀐다(사람이 설정에서 바꾼 것을 앱이 덮지 못하게 막아 둔 것이다).
      **소리를 바꾸려면 id를 새로 만드는 수밖에 없다** — 그래서 뒤에
      `_v1`을 붙여 두었다. 바꿀 일이 생기면 `_v2`로 올릴 것.
      **발송기(`supabase/functions/notify`)의 `channel_id`와 같은 글자여야
      한다** — 어긋나면 안드로이드가 모르는 채널로 보고 기본음으로 띄운다.
    -->
    <string name="notify_channel_id" translatable="false">kkakkung_v1</string>
    <!-- 폰의 `설정 → 알림`에 이 이름으로 뜬다. 사람이 읽는 말이다. -->
    <string name="notify_channel_name">까꿍 알림</string>
    <string name="notify_channel_desc">라운드·정산·대화 등 앱에서 오는 알림</string>

    <!-- 상태 막대 아이콘을 칠하는 색. `tokens.css`의 분홍(brand)과 같은 값이다. -->
    <color name="notify_color">#D92B8E</color>
</resources>
